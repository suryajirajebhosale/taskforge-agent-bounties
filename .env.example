# Local Postgres via `docker compose up -d postgres`; each service falls back to its
# own local sqlite file if unset (fine for quick iteration, not for production). Both
# services share one Postgres instance/database locally — their tables don't collide —
# though each is still independently deployable to its own database in real environments.

# Escrow Ledger Service
ESCROW_DATABASE_URL=postgresql+psycopg://taskforge:taskforge@localhost:5432/taskforge
ESCROW_STRIPE_API_KEY=sk_test_...
ESCROW_INTERNAL_API_KEY=change-me
ESCROW_DEFAULT_TAKE_RATE_BPS=1000

# Agent SDK & Submission Intake
AGENT_DATABASE_URL=postgresql+psycopg://taskforge:taskforge@localhost:5432/taskforge
AGENT_INTERNAL_API_KEY=change-me
AGENT_MAX_SUBMISSIONS_PER_AGENT_PER_WINDOW=20
AGENT_MAX_SUBMISSIONS_PER_DEVELOPER_PER_WINDOW=50
AGENT_RATE_LIMIT_WINDOW_MINUTES=60

# Bounty Requirement/Rubric Module
RUBRIC_DATABASE_URL=postgresql+psycopg://taskforge:taskforge@localhost:5432/taskforge
RUBRIC_INTERNAL_API_KEY=change-me
RUBRIC_MODEL_BACKEND=openai
RUBRIC_MODEL_NAME=gpt-4o-mini
RUBRIC_MODEL_API_KEY=sk-...
# RUBRIC_MODEL_BACKEND=nvidia_nim uses the same ChatOpenAI client against NVIDIA's
# OpenAI-compatible NIM endpoint — set RUBRIC_MODEL_API_KEY to an NVIDIA API key and
# RUBRIC_MODEL_NAME to the NIM-hosted model name in that case.

# Oracle Verification Service
ORACLE_DATABASE_URL=postgresql+psycopg://taskforge:taskforge@localhost:5432/taskforge
ORACLE_INTERNAL_API_KEY=change-me
ORACLE_JUDGE_MODEL_BACKEND=openai
ORACLE_JUDGE_MODEL_NAME=gpt-4o-mini
ORACLE_JUDGE_MODEL_API_KEY=sk-...
ORACLE_DISPUTE_MODEL_BACKEND=openai
ORACLE_DISPUTE_MODEL_NAME=gpt-4o
ORACLE_DISPUTE_MODEL_API_KEY=sk-...
ORACLE_DEFAULT_CONFIDENCE_THRESHOLD=0.85
ORACLE_AUTO_RESOLVE_AMOUNT_CENTS_CEILING=50000
# Oracle calls these three services directly to notify Agent Platform, release escrow
# on a confirmed pass, and report the outcome to Reputation (see
# services/oracle_service/downstream_clients.py):
ORACLE_ESCROW_BASE_URL=http://localhost:8001
ORACLE_ESCROW_INTERNAL_API_KEY=change-me
ORACLE_AGENT_PLATFORM_BASE_URL=http://localhost:8002
ORACLE_AGENT_PLATFORM_INTERNAL_API_KEY=change-me
ORACLE_REPUTATION_BASE_URL=http://localhost:8003
ORACLE_REPUTATION_INTERNAL_API_KEY=change-me

# Reputation & Leaderboard Module
REPUTATION_DATABASE_URL=postgresql+psycopg://taskforge:taskforge@localhost:5432/taskforge
REPUTATION_INTERNAL_API_KEY=change-me
REPUTATION_DECAY_ALPHA=0.15
REPUTATION_WEEKLY_PRIZE_AMOUNT_CENTS=2500
REPUTATION_WEEK_START_DAY=6
