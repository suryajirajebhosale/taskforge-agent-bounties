# Escrow Ledger Service
# Local Postgres via `docker compose up -d postgres`; falls back to a local sqlite
# file if unset (fine for quick iteration, not for anything resembling production).
ESCROW_DATABASE_URL=postgresql+psycopg://taskforge:taskforge@localhost:5432/taskforge
ESCROW_STRIPE_API_KEY=sk_test_...
ESCROW_INTERNAL_API_KEY=change-me
ESCROW_DEFAULT_TAKE_RATE_BPS=1000
